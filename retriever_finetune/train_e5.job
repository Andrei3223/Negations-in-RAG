#!/bin/bash
#SBATCH --job-name=e5-negft
#SBATCH --partition=gpu
#SBATCH --gres=gpu:nvidia_rtx_a6000:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --output=/home/16207041/Negations-in-RAG/logs/%x-%j.out
#SBATCH --error=/home/16207041/Negations-in-RAG/logs/%x-%j.err
#
# Fine-tune the e5 retriever on NevIR + negations-free-sentence pairs, with an equal
# number of MS MARCO queries mixed into every batch (InfoNCE) against forgetting.
# Retriever only: needs no retrieval server and no generator. Config:
# retriever_finetune/conf/config.yaml.
#
# Once, before the first run (CPU, ~1 min; reads the shared MS MARCO copy):
#
#   python -m retriever_finetune.prepare_marco
#
# Negation pairs only, as before: add marco=none.
#
#   sbatch retriever_finetune/train_e5.job                               # defaults
#   sbatch retriever_finetune/train_e5.job loss.lam=0.5 negatives.num_mined=4
#   sbatch retriever_finetune/train_e5.job trainer.eval_only=true        # base e5 baseline
#
# Sweep inside one job (runs one after another, one wandb run each):
#
#   sbatch --export=ALL,EXTRA_OVERRIDES="-m loss.lam=0.1,0.3,0.5" retriever_finetune/train_e5.job
#
# A run is ~280 steps on 891 pairs: minutes, not hours. 12h covers a sweep.
# One GPU is enough: e5-base is 110M parameters, and with gradient checkpointing
# a 32-pair step with 4 mined docs per query stays far below 48 GB.
#
# Output: best/ and last/ (HF format) plus metrics.json under trainer.output_dir
# (/fnwi_fs/.../retriever_checkpoints/<experiment>/<time>/). Serving one with
# retrieval_server.py --retriever_model <dir> --retriever_name e5 needs an index
# re-encoded with the same model, unless the run used
# model.freeze_passage_encoder=true (then the existing index stays valid).

set -eo pipefail

cd /home/16207041/Negations-in-RAG
source run/env.sh            # HF_HOME (cached e5-base-v2), WANDB_API_KEY from run/.env
conda activate "$TRAIN_ENV"  # searchr1: torch 2.4, transformers 4.47, hydra 1.3, wandb

echo "node=$(hostname)  job=${SLURM_JOB_ID:-none}  gpus=${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true

# EXTRA_OVERRIDES is split on spaces on purpose: it holds several Hydra arguments.
# shellcheck disable=SC2086
exec python -u -m retriever_finetune.train $EXTRA_OVERRIDES "$@"
